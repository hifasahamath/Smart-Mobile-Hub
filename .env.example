# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/smart_mobile_hub
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT
JWT_SECRET=mySecretKey123456789012345678901234567890

# SMTP (for notification-service)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Gemini AI (for ai-service)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Services (internal URLs for inter-service communication)
CATALOG_SERVICE_URL=http://localhost:8082
INVENTORY_SERVICE_URL=http://localhost:8083
